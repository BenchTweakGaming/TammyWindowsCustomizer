<Window x:Class="TammyWindowsCustomizer.About"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        xmlns:local="clr-namespace:TammyWindowsCustomizer"
        mc:Ignorable="d"
        ResizeMode="CanMinimize"        
        WindowStyle="ToolWindow"
        
        Title="About" Height="200" Width="270"
>
    <Viewbox Name="vbAboutWindow">
        <Grid Height="160" Width="270"  HorizontalAlignment="Stretch">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10*" />
                        <ColumnDefinition Width="10*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="50"/>
                       
                        <RowDefinition Height="20"/>
                        <!--<RowDefinition Height="20"/>-->
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Name="TextBlock2"    
                Text="Tammy Windows Customizer" FontSize="14" FontFamily="Verdana" FontWeight="Bold"  
                TextAlignment="Center" VerticalAlignment="Top" Margin="0,2"></TextBlock>
                    <TextBlock Grid.Row="1" HorizontalAlignment="Center">
                    <Hyperlink NavigateUri="https://github.com/BenchTweakGaming" TextDecorations="None" RequestNavigate="Hyperlink_RequestNavigate">
                        <Image Source="/Resources/tammy_logo.png" Height="60" Margin="0,0,0,0"></Image>
                    </Hyperlink>
                    </TextBlock>
                    <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,0">
                    <Hyperlink NavigateUri="https://benchtweakgaming.com/tammy-windows-customizer/" TextDecorations="None" RequestNavigate="Hyperlink_RequestNavigate">
                        <Image Source="/Resources/BTGV2LOGORED.png" Height="60" Margin="17,0,0,0"></Image>
                    </Hyperlink>
                    </TextBlock>
                    <DockPanel Grid.Row="2" Grid.ColumnSpan="2">
                        <TextBlock Name="TextBlockWithHyperlink" TextAlignment="Center" FontSize="13" Grid.Column="0" VerticalAlignment="Top" Margin="20,0,0,0">
                        <Hyperlink NavigateUri="https://github.com/BenchTweakGaming" RequestNavigate="Hyperlink_RequestNavigate">
                            Tammy Windows<LineBreak /> Customizer
                        </Hyperlink>
                        </TextBlock>
                        
                        <TextBlock Name="TextBlockWithHyperlink2" FontSize="13" Margin="12,0,0,0">
                        <Hyperlink NavigateUri="https://benchtweakgaming.com/tammy-windows-customizer/"
                                RequestNavigate="Hyperlink_RequestNavigate">
                                BenchTweakGaming
                        </Hyperlink>
                        </TextBlock>
                    </DockPanel>
                   
                    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Name="tbCopyright" Height="20" Width="200"  
                Text="© 2020 — 2025" 
                Margin="0,0,0,0" VerticalAlignment="Top"  
                FontSize="12" FontFamily="Verdana" 
                TextWrapping="Wrap" TextAlignment="Center" Padding="5">
                    </TextBlock>
                    <!--
                <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Name="tbVersion" Height="20" Width="200"  
Text="v2.8.0" 
Margin="0,0,0,0" VerticalAlignment="Top"  
FontSize="12" FontFamily="Verdana" 
TextWrapping="Wrap" TextAlignment="Center" Padding="5">
                </TextBlock>-->

                </Grid>
            </StackPanel>

        </Grid>
    </Viewbox>
</Window>
